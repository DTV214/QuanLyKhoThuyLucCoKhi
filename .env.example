# Sao chép thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server. Tuyệt đối không đặt tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Cloudinary → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kho-thanh-danh

# Địa chỉ web (dùng cho link đặt lại mật khẩu trong email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tài khoản ông chủ đầu tiên (chỉ dùng cho lệnh npm run seed:owner, xoá sau khi tạo)
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_FULL_NAME=
